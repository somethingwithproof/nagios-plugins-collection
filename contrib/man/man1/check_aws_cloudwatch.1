.SH NAME
check_aws_cloudwatch \- Check AWS CloudWatch metrics plugin.
.SH SYNOPSIS
.B check_aws_cloudwatch
[\fB\-\-timeout\fR \fITIMEOUT\fR] [\fB\-\-warning\fR \fIWARNING\fR] [\fB\-\-critical\fR \fICRITICAL\fR] [\fB\-\-json\fR] \fB\-\-namespace\fR \fINAMESPACE\fR \fB\-\-metric\fR \fIMETRIC\fR [\fB\-\-region\fR \fIREGION\fR] [\fB\-\-statistic\fR \fISTATISTIC\fR] [\fB\-\-period\fR \fIPERIOD\fR] [\fB\-\-minutes\-back\fR \fIMINUTES_BACK\fR] [\fB\-\-instance\-id\fR \fIINSTANCE_ID\fR] [\fB\-\-db\-instance\-id\fR \fIDB_INSTANCE_ID\fR] [\fB\-\-function\-name\fR \fIFUNCTION_NAME\fR] [\fB\-\-load\-balancer\-name\fR \fILOAD_BALANCER_NAME\fR] [\fB\-\-dimensions\fR \fIDIMENSIONS\fR]
