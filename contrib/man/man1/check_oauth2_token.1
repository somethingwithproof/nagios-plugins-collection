.SH NAME
check_oauth2_token \- Obtain an OAuth2 token and report time\-to\-expiry; validate scopes if provided.
.SH SYNOPSIS
.B check_oauth2_token
[\fB\-\-timeout\fR \fITIMEOUT\fR] [\fB\-\-warning\fR \fIWARNING\fR] [\fB\-\-critical\fR \fICRITICAL\fR] [\fB\-\-json\fR] \fB\-\-token\-url\fR \fITOKEN_URL\fR \fB\-\-client\-id\fR \fICLIENT_ID\fR [\fB\-\-client\-secret\-file\fR \fIPATH\fR] [\fB\-\-scope\fR \fISCOPE\fR] [\fB\-\-ca\-file\fR \fIPATH\fR] [\fB\-\-insecure\fR] [\fB\-\-client\-cert\fR \fIPATH\fR] [\fB\-\-client\-key\fR \fIPATH\fR] [\fB\-\-max\-response\-bytes\fR \fIBYTES\fR] [\fB\-\-retries\fR \fIRETRIES\fR] [\fB\-\-retry\-delay\fR \fISECONDS\fR]
